VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN minimal_test ;
UNITS DISTANCE MICRONS 1000 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 2 ;
    - A + NET A + DIRECTION INPUT + USE SIGNAL ;
    - Y + NET Y + DIRECTION OUTPUT + USE SIGNAL ;
END PINS
NETS 2 ;
    - A ( PIN A ) + USE SIGNAL ;
    - Y ( PIN Y ) + USE SIGNAL ;
END NETS
END DESIGN
